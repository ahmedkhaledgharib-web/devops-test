# Development environment (Docker Compose + Neon Local)
#
# Copy this file to .env.development and fill in the Neon credentials:
#   cp .env.development.example .env.development
#
# Neon Local exposes fixed local credentials (neon / npg) and the database
# segment must match a database that exists on the Neon branch (default: neondb).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Local proxy connection string. "neon-local" is the Compose service name;
# inside the app container it must NOT be localhost. Use localhost only when
# running the app on your host against the published proxy port.
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb?sslmode=no-verify

# Route the Neon serverless driver to the Neon Local proxy.
# The fetch endpoint is derived from DATABASE_URL (http://neon-local:5432/sql)
# unless NEON_LOCAL_FETCH_ENDPOINT is set.
NEON_LOCAL=true
NEON_LOCAL_FETCH_ENDPOINT=http://neon-local:5432/sql

# Neon Local branch provisioning (required by the proxy container)
NEON_API_KEY=napi_xrp1p8nfip3a17ky8l761x93xpud73vry555whgesq4ldvfcjes4ooimifyuth43
NEON_PROJECT_ID=soft-mode-69853792

# Ephemeral branch parent. Omit (or leave commented) to use the project's
# default branch. The branch is created on `up` and deleted on `down`.
# PARENT_BRANCH_ID=br-your-parent-branch-id
DELETE_BRANCH=true

# Arcjet (the app's security middleware requires a key)
ARCJET_KEY=aj_prj_key_01m522vn1zev6vmv8hncevcb50
