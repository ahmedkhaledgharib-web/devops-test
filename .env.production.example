# Production environment (Neon Cloud / serverless)
#
# Copy this file to .env.production and provide real values through your
# secret manager or CI/CD variables. NEVER commit real credentials.
#   cp .env.production.example .env.production
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Neon Cloud serverless connection string (pooled endpoint recommended).
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-xxxxxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Production must never use the local proxy.
NEON_LOCAL=false

# Arcjet
ARCJET_KEY=replace-with-your-arcjet-key
